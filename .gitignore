node_modules/
out/
*.tsbuildinfo

# Packaged extension artifacts — these are release outputs, never source.
# Committing them is what bloated the previous history; publish them to
# GitHub Releases instead.
*.vsix
*.zip

# Generated at Pages build time from docs/*.md and the latest release.
# The markdown in docs/ stays the single source of truth.
site/docs/
site/latest.json

# Local workspace state written by the extension itself.
.blacksite/

# Test/debug output
.vscode-test/
coverage/
*.log
