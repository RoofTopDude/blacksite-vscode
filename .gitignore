node_modules/
out/
*.tsbuildinfo

# Packaged extension artifacts — these are release outputs, never source.
# Committing them is what bloated the previous history; publish them to
# GitHub Releases instead.
*.vsix
*.zip

# Generated at Pages build time by scripts/build-site.mjs. The sources of
# truth are site/pages/*.html (page bodies), docs/**/*.md (documents), and
# node_modules/lucide-react (the icon sprite).
site/*.html
site/docs/
site/icons.svg
site/latest.json

# Local workspace state written by the extension itself.
.blacksite/

# Test/debug output
.vscode-test/
coverage/
*.log
