{
  "name": "blacksite-vscode",
  "publisher": "blacksite",
  "displayName": "Blacksite",
  "description": "AI coding assistant with deep workspace integration",
  "version": "0.2.0",
  "icon": "media/extension-icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/RoofTopDude/Blacksite-AI.git"
  },
  "private": true,
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "AI",
    "Programming Languages"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "blacksite",
          "title": "Blacksite",
          "icon": "media/activity-icon.png"
        }
      ]
    },
    "views": {
      "blacksite": [
        {
          "type": "webview",
          "id": "blacksite.chat",
          "name": "Chat"
        },
        {
          "type": "webview",
          "id": "blacksite.plans",
          "name": "Plans",
          "icon": "media/plans-view.png"
        },
        {
          "type": "webview",
          "id": "blacksite.baseContext",
          "name": "Base Context",
          "icon": "media/base-context-view.png"
        },
        {
          "type": "webview",
          "id": "blacksite.data",
          "name": "Data",
          "icon": "media/data-view.png"
        },
        {
          "type": "webview",
          "id": "blacksite.map",
          "name": "Map",
          "icon": "media/map-view.png"
        }
      ]
    },
    "commands": [
      {
        "command": "blacksite.openChat",
        "title": "Open Chat Panel",
        "category": "Blacksite"
      },
      {
        "command": "blacksite.clearChat",
        "title": "Clear Chat",
        "category": "Blacksite"
      },
      {
        "command": "blacksite.cancelRun",
        "title": "Cancel Current Run",
        "category": "Blacksite"
      },
      {
        "command": "blacksite.setApiKey",
        "title": "Set API Key",
        "category": "Blacksite"
      },
      {
        "command": "blacksite.explainSelection",
        "title": "Explain Selection",
        "category": "Blacksite"
      },
      {
        "command": "blacksite.askAboutFile",
        "title": "Ask About This File",
        "category": "Blacksite"
      },
      {
        "command": "blacksite.fixDiagnostic",
        "title": "Fix with Blacksite",
        "category": "Blacksite"
      },
      {
        "command": "blacksite.manageMcp",
        "title": "Manage MCP Servers",
        "category": "Blacksite"
      },
      {
        "command": "blacksite.closeBrowser",
        "title": "Close Browser Window",
        "category": "Blacksite"
      },
      {
        "command": "blacksite.clearProblems",
        "title": "Clear Problems",
        "category": "Blacksite"
      },
      {
        "command": "blacksite.addFileToBaseContext",
        "title": "Add File To Base Context",
        "category": "Blacksite"
      },
      {
        "command": "blacksite.attachFileToChat",
        "title": "Attach File To Chat",
        "category": "Blacksite"
      },
      {
        "command": "blacksite.showLogs",
        "title": "Show Execution Logs",
        "category": "Blacksite"
      },
      {
        "command": "blacksite.compactConversation",
        "title": "Compact Conversation History",
        "category": "Blacksite"
      },
      {
        "command": "blacksite.openData",
        "title": "Open Data Workbench",
        "category": "Blacksite"
      },
      {
        "command": "blacksite.refreshData",
        "title": "Refresh Data Catalog",
        "category": "Blacksite"
      },
      {
        "command": "blacksite.runQuery",
        "title": "Run Database Query",
        "category": "Blacksite"
      },
      {
        "command": "blacksite.openSavedQuery",
        "title": "Open Saved Query",
        "category": "Blacksite"
      },
      {
        "command": "blacksite.checkForUpdates",
        "title": "Check For Extension Updates",
        "category": "Blacksite"
      },
      {
        "command": "blacksite.openMap",
        "title": "Open Codebase Map",
        "category": "Blacksite"
      },
      {
        "command": "blacksite.rebuildMap",
        "title": "Rebuild Codebase Map Index",
        "category": "Blacksite"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "blacksite.explainSelection",
          "when": "editorHasSelection",
          "group": "blacksite@1"
        },
        {
          "command": "blacksite.askAboutFile",
          "when": "resourceScheme == file",
          "group": "blacksite@2"
        },
        {
          "command": "blacksite.addFileToBaseContext",
          "when": "resourceScheme == file",
          "group": "blacksite@3"
        },
        {
          "command": "blacksite.attachFileToChat",
          "when": "resourceScheme == file",
          "group": "blacksite@4"
        }
      ],
      "explorer/context": [
        {
          "command": "blacksite.askAboutFile",
          "when": "resourceScheme == file && !explorerResourceIsFolder",
          "group": "blacksite@1"
        },
        {
          "command": "blacksite.addFileToBaseContext",
          "when": "resourceScheme == file && !explorerResourceIsFolder",
          "group": "blacksite@2"
        },
        {
          "command": "blacksite.attachFileToChat",
          "when": "resourceScheme == file && !explorerResourceIsFolder",
          "group": "blacksite@3"
        }
      ],
      "commandPalette": [
        {
          "command": "blacksite.fixDiagnostic",
          "when": "false"
        }
      ]
    },
    "keybindings": [
      {
        "command": "blacksite.explainSelection",
        "key": "ctrl+shift+e",
        "mac": "cmd+shift+e",
        "when": "editorHasSelection"
      }
    ],
    "configuration": {
      "title": "Blacksite",
      "properties": {
        "blacksite.provider": {
          "type": "string",
          "default": "anthropic",
          "enum": [
            "anthropic",
            "openrouter",
            "openai",
            "bedrock"
          ],
          "enumDescriptions": [
            "Anthropic Claude (direct)",
            "OpenRouter (access many models via one key)",
            "OpenAI",
            "AWS Bedrock (SigV4-signed Converse API)"
          ],
          "description": "AI provider for chat. Can also be set in the sidepanel Settings."
        },
        "blacksite.bedrockApi": {
          "type": "string",
          "default": "converse",
          "enum": [
            "converse",
            "mantle"
          ],
          "enumDescriptions": [
            "Converse API — live model listing, dated inference-profile IDs",
            "Messages (Mantle) API — Anthropic-native endpoint, supports Opus 4.7/4.8 and Fable 5"
          ],
          "description": "Bedrock API path. 'mantle' enables the Messages endpoint required for the latest Claude models not yet on Converse. Can also be toggled in the sidepanel Settings."
        },
        "blacksite.model": {
          "type": "string",
          "default": "",
          "description": "Model override (empty = provider default: claude-sonnet-4-6)"
        },
        "blacksite.workspaceRoot": {
          "type": "string",
          "default": "",
          "description": "Workspace root for local runtime (defaults to first workspace folder)"
        },
        "blacksite.autoConfirmReadOps": {
          "type": "boolean",
          "default": true,
          "description": "Auto-confirm read-tier operations without a prompt"
        },
        "blacksite.permissions.allowedCommands": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          },
          "markdownDescription": "Extra terminal binaries the agent may run, added to the built-in allowlist (for example `docker-compose`). Compared by command name, case-insensitive.",
          "scope": "resource"
        },
        "blacksite.permissions.deniedCommands": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          },
          "markdownDescription": "Terminal binaries the agent may never run. A deny entry overrides the allowlist and auto-approve (for example `curl`, `ssh`).",
          "scope": "resource"
        },
        "blacksite.permissions.autoApprove": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          },
          "markdownDescription": "Terminal binaries whose network/destructive operations run without an approval prompt. Populated by choosing \"Always allow\" on an approval, or edit manually (for example `git`, `npm`).",
          "scope": "resource"
        },
        "blacksite.permissions.allowEvalFlags": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "⚠️ Advanced & unsafe. Permit inline-eval arguments (`node -e`, `python -c`, `ruby -e`, …) that are blocked by default. Enabling this lets the agent execute arbitrary code passed directly on the command line.",
          "scope": "resource"
        },
        "blacksite.graph.traceFadeSeconds": {
          "type": "number",
          "default": 45,
          "minimum": 2,
          "maximum": 3600,
          "description": "How long (seconds) agent activity traces on the Codebase Map take to fully fade."
        },
        "blacksite.graph.maxNodes": {
          "type": "number",
          "default": 4000,
          "minimum": 100,
          "maximum": 20000,
          "description": "Legacy compatibility cap for files rendered on the Codebase Map. Use performanceProfile and advanced caps for larger workspaces."
        },
        "blacksite.graph.performanceProfile": {
          "type": "string",
          "default": "balanced",
          "enum": [
            "safe",
            "balanced",
            "large",
            "extreme",
            "custom"
          ],
          "enumDescriptions": [
            "Conservative caps for average machines.",
            "Default caps for normal monorepos.",
            "Higher caps for capable workstations.",
            "Very high caps for large machines and large workspaces.",
            "Use explicit advanced caps below."
          ],
          "description": "Codebase Map capacity profile."
        },
        "blacksite.graph.maxIndexedFiles": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "maximum": 250000,
          "description": "Advanced: maximum files scanned for Map indexing and service relationship detection. 0 uses the selected performance profile."
        },
        "blacksite.graph.maxRenderedStars": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "maximum": 100000,
          "description": "Advanced: maximum file/service stars rendered in the Map. 0 uses the selected performance profile or legacy maxNodes."
        },
        "blacksite.graph.maxRelationshipEdges": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "maximum": 150000,
          "description": "Advanced: maximum service/API relationship edges sent to the Map. 0 uses the selected performance profile."
        },
        "blacksite.graph.traceShellEvents": {
          "type": "boolean",
          "default": true,
          "description": "Show shell/terminal activity (working-directory pulses) on the Codebase Map trace layer."
        },
        "blacksite.data.previewPageSize": {
          "type": "number",
          "default": 50,
          "description": "Number of rows per page in the Data workbench table preview."
        },
        "blacksite.data.maxQueryRows": {
          "type": "number",
          "default": 500,
          "description": "Maximum rows returned by a read query in the Data workbench Query tab."
        },
        "blacksite.data.enableAssistant": {
          "type": "boolean",
          "default": true,
          "description": "Enable the natural-language database assistant in the Data workbench."
        },
        "blacksite.data.backendMode": {
          "type": "string",
          "default": "exact_local",
          "enum": [
            "exact_local",
            "pgvector_container"
          ],
          "enumDescriptions": [
            "Embedded exact vector search persisted in SQLite (default, zero dependencies)",
            "Optional local PostgreSQL + pgvector sidecar for higher-scale retrieval"
          ],
          "description": "Vector backend for the Data workbench."
        },
        "blacksite.browserHeadless": {
          "type": "boolean",
          "default": false,
          "description": "Run the agent's browser window in headless mode (no visible window). Default is headed so you can watch what the agent does."
        },
        "blacksite.updates.checkOnStartup": {
          "type": "boolean",
          "default": true,
          "description": "Check GitHub for newer Blacksite VS Code extension releases on startup. This does not use the VS Code Marketplace."
        },
        "blacksite.updates.includePrerelease": {
          "type": "boolean",
          "default": false,
          "description": "Allow prerelease GitHub builds when checking for VS Code extension updates."
        },
        "blacksite.updates.repository": {
          "type": "string",
          "default": "",
          "description": "GitHub owner/repo used for VS Code extension self-updates (for example RoofTopDude/Blacksite-AI). Leave blank to use the repository declared in the extension package."
        },
        "blacksite.mcpServers": {
          "type": "array",
          "default": [],
          "description": "MCP server list (managed via Blacksite: Manage MCP Servers)",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "transport": {
                "type": "string",
                "enum": [
                  "stdio",
                  "http"
                ]
              },
              "command": {
                "type": "string"
              },
              "url": {
                "type": "string"
              },
              "enabled": {
                "type": "boolean"
              }
            }
          }
        }
      }
    }
  },
  "scripts": {
    "build": "npm run build:webview && node esbuild.mjs",
    "build:webview": "node ../../node_modules/vite/bin/vite.js build --config vite.webview.config.mjs",
    "watch": "node esbuild.mjs --watch",
    "watch:webview": "node ../../node_modules/vite/bin/vite.js build --watch --config vite.webview.config.mjs",
    "compile": "tsc -p tsconfig.json --noEmit",
    "typecheck:webview": "tsc -p src/webview/react/tsconfig.json",
    "package": "npm run package:vsix",
    "package:vsix": "npm run build && npx --no-install vsce package",
    "test:unit": "node scripts/run-vitest.mjs vitest.config.ts",
    "test:unit:soak": "node -e \"console.log('1000-turn soak coverage currently runs inside npm run test:unit')\"",
    "analyze:execution": "node scripts/analyze-execution-log.mjs"
  },
  "dependencies": {
    "jimp": "^1.6.1",
    "jq-wasm": "^2.0.0-jq-1.8.2"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "playwright-core": "^1.59.0",
    "typescript": "^5.4.0"
  }
}
