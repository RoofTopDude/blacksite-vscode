# TypeScript source — bundled into out/extension.js at build time
src/**

# Vendored workspace packages (@blacksite/local-runtime, file-content,
# browser-bridge-protocol) — aliased and bundled into out/extension.js by
# esbuild.mjs, exactly like src/**, so the sources must not ship in the VSIX.
packages/**

# Build tooling
esbuild.mjs
eslint.config.mjs
tsconfig.json
*.tsbuildinfo
vite.webview.config.mjs
vitest*.config.ts
plan.md
scripts/**

# All node_modules are bundled except runtime-only externals. Playwright Core is
# retained so Execution Runs work in an installed VSIX against system Chrome/Edge;
# jq-wasm remains external because its worker shim depends on import.meta.url.
node_modules/**
!node_modules/jq-wasm/**
!node_modules/playwright-core/**
# Mount previews use a workspace-native esbuild when available and otherwise the portable WASM
# runtime below. Do not ship the release builder's native esbuild binary: it cannot run on macOS
# (or any OS different from the runner that packaged the VSIX).
!node_modules/esbuild-wasm/**
# Cross-platform HEIC/HEIF image decoding (attachments). libheif-js loads its .wasm binary
# relative to its own package directory, so it must ship as a real node_modules directory
# rather than being bundled — same reasoning as esbuild-wasm/jq-wasm above.
!node_modules/heic-decode/**
!node_modules/libheif-js/**
# pdf.js is external so it is not evaluated on every activation (see esbuild.mjs). Only the
# one entry file ships — the package on disk is 35MB of builds, types, and standard fonts this
# extension never loads, and the worker is already staged to out/pdf.worker.mjs.
!node_modules/pdfjs-dist/package.json
!node_modules/pdfjs-dist/legacy/build/pdf.mjs
# React for question-card previews in projects that do not install it (src/preview-build.ts
# resolves it only when the workspace has no React of its own). Previews define NODE_ENV as
# "development", so only the development builds are ever bundled; esbuild skips the dead
# production branches without resolving them.
!node_modules/react/package.json
!node_modules/react/LICENSE
!node_modules/react/index.js
!node_modules/react/jsx-runtime.js
!node_modules/react/jsx-dev-runtime.js
!node_modules/react/cjs/react.development.js
!node_modules/react/cjs/react-jsx-runtime.development.js
!node_modules/react/cjs/react-jsx-dev-runtime.development.js
!node_modules/react-dom/package.json
!node_modules/react-dom/LICENSE
!node_modules/react-dom/index.js
!node_modules/react-dom/client.js
!node_modules/react-dom/cjs/react-dom.development.js
!node_modules/react-dom/cjs/react-dom-client.development.js
!node_modules/scheduler/package.json
!node_modules/scheduler/LICENSE
!node_modules/scheduler/index.js
!node_modules/scheduler/cjs/scheduler.development.js

# Lock file and docs
package-lock.json
docs/**
tests/**
coverage/**
# Contributor-facing docs, same reasoning as docs/** — they describe building the
# extension, not using it. SECURITY.md deliberately stays: an installed user who finds
# a vulnerability should be able to read the reporting path without visiting GitHub.
ARCHITECTURE.md
CONTRIBUTING.md

# First-party skills are staged into out/skills by esbuild.mjs (SkillStore reads them
# from there); the authoring copies at the repo root must not ship a second time.
skills/**

# Repository infrastructure, not extension payload. The marketing site (with
# two woff2 files) and the CI workflows were being vacuumed into the VSIX
# because they were added after this file was written.
site/**
.github/**
.gitattributes

# Local workspace state must never ship in the VSIX.
.blacksite/**
.vscode/**
# Scratch directories from local tooling runs. Untracked, so they are invisible in
# `git status --short` review but still vacuumed into the package by vsce.
.tmp-*/**

# Source maps (keeps VSIX smaller; omit for production distribution)
out/**/*.js.map

# Git internals
.git/**
.gitignore

# A leftover .vsix/.zip from a prior local `npm run package` run otherwise
# gets vacuumed into the next one, doubling its size with a copy of itself.
*.vsix
*.zip
