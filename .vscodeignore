# TypeScript source — bundled into out/extension.js at build time
src/**

# Vendored workspace packages (@blacksite/local-runtime, file-content,
# browser-bridge-protocol) — aliased and bundled into out/extension.js by
# esbuild.mjs, exactly like src/**, so the sources must not ship in the VSIX.
packages/**

# Build tooling
esbuild.mjs
eslint.config.mjs
tsconfig.json
*.tsbuildinfo
vite.webview.config.mjs
vitest.config.ts
scripts/**

# All node_modules are bundled except runtime-only externals. Playwright Core is
# retained so Execution Runs work in an installed VSIX against system Chrome/Edge;
# jq-wasm remains external because its worker shim depends on import.meta.url.
node_modules/**
!node_modules/jq-wasm/**
!node_modules/playwright-core/**
# Mount previews use a workspace-native esbuild when available and otherwise the portable WASM
# runtime below. Do not ship the release builder's native esbuild binary: it cannot run on macOS
# (or any OS different from the runner that packaged the VSIX).
!node_modules/esbuild-wasm/**

# Lock file and docs
package-lock.json
docs/**
tests/**

# First-party skills are staged into out/skills by esbuild.mjs (SkillStore reads them
# from there); the authoring copies at the repo root must not ship a second time.
skills/**

# Repository infrastructure, not extension payload. The marketing site (with
# two woff2 files) and the CI workflows were being vacuumed into the VSIX
# because they were added after this file was written.
site/**
.github/**
.gitattributes

# Local workspace state must never ship in the VSIX.
.blacksite/**
.vscode/**
# Scratch directories from local tooling runs. Untracked, so they are invisible in
# `git status --short` review but still vacuumed into the package by vsce.
.tmp-*/**

# Source maps (keeps VSIX smaller; omit for production distribution)
out/**/*.js.map

# Git internals
.git/**
.gitignore

# A leftover .vsix/.zip from a prior local `npm run package` run otherwise
# gets vacuumed into the next one, doubling its size with a copy of itself.
*.vsix
*.zip
