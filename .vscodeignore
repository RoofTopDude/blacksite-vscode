# TypeScript source — bundled into out/extension.js at build time
src/**

# Vendored workspace packages (@blacksite/local-runtime, file-content,
# browser-bridge-protocol) — aliased and bundled into out/extension.js by
# esbuild.mjs, exactly like src/**, so the sources must not ship in the VSIX.
packages/**

# Build tooling
esbuild.mjs
eslint.config.mjs
tsconfig.json
*.tsbuildinfo
vite.webview.config.mjs
vitest.config.ts
scripts/**

# All node_modules — everything is bundled by esbuild; playwright-core is dev-only.
# jq-wasm is excluded from bundling (its import.meta.url-based worker shim breaks under
# esbuild's CJS output) and loaded from node_modules at runtime instead — keep it real.
node_modules/**
!node_modules/jq-wasm/**

# Lock file and docs
package-lock.json
docs/**
tests/**

# Local workspace state must never ship in the VSIX.
.blacksite/**

# Source maps (keeps VSIX smaller; omit for production distribution)
out/**/*.js.map

# Git internals
.git/**
.gitignore

# A leftover .vsix/.zip from a prior local `npm run package` run otherwise
# gets vacuumed into the next one, doubling its size with a copy of itself.
*.vsix
*.zip
