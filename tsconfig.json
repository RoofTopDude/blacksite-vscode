{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "outDir": "out",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "sourceMap": true,
    "declaration": false,
    "baseUrl": ".",
    "paths": {
      "@blacksite/core-agent/*": ["../../packages/core-agent/src/*"],
      "@blacksite/local-runtime": ["../../packages/local-runtime/src/index.ts"],
      "@blacksite/local-runtime/*": ["../../packages/local-runtime/src/*"],
      "@blacksite/browser-bridge-protocol": ["../../packages/browser-bridge-protocol/src/index.ts"]
    }
  },
  "include": [
    "src/**/*.ts",
    "../../packages/core-agent/src/**/*.ts",
    "../../packages/local-runtime/src/**/*.ts",
    "../../packages/browser-bridge-protocol/src/**/*.ts"
  ],
  "exclude": ["node_modules", "out"]
}
